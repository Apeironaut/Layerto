POSTGRES_PORT=5434
# Goose migrations connect via MIGRATOR_DATABASE_URL (or superuser)
MIGRATOR_DATABASE_URL=postgres://layerto:layerto@localhost:5434/layerto?sslmode=disable
# Core application connects as layerto_app
DATABASE_URL=postgres://layerto_app:layerto_app_pass@localhost:5434/layerto?sslmode=disable
TEST_DATABASE_URL=postgres://layerto:layerto@localhost:5434/layerto_test?sslmode=disable
TEST_APP_DATABASE_URL=postgres://layerto_app:layerto_app_pass@localhost:5434/layerto_test?sslmode=disable

APP_USER=layerto_app
APP_PASSWORD=layerto_app_pass
MIGRATOR_USER=layerto_migrator
MIGRATOR_PASSWORD=layerto_migrator_pass

PORT=8080
ADMIN_TOKEN=change-me
MODEL_FAKE=1
RUNPOD_API_KEY=
FREE_CALLS=50
SESSION_TTL_HOURS=336
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
RATE_LIMIT_PER_MIN=60

# Links in emails (password reset) point here
DASHBOARD_URL=http://localhost:5174
# Email: set SMTP_HOST to send real email (port 587 STARTTLS; SMTP_TLS=implicit for 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Layerto <no-reply@layerto.com>
# Local development only: print emails (including reset links) to the backend log.
MAIL_DEV_LOG=1

# --- Layerto Studio (datasets, training, custom models, sites) ---
# Where dataset images and model weights are stored (encrypted). Use a persistent disk.
STORAGE_DIR=./data
# 64 hex characters (32 bytes) for AES-256-GCM. Generate: openssl rand -hex 32
# Without it a development key is used - never in production. Changing it makes stored files unreadable.
DATA_KEY=
# Public URL of this API, put into training notebooks and used by trainers
PUBLIC_API_URL=http://localhost:8080
# Shared secret for Layerto GPU training workers and the LTVision RunPod worker (openssl rand -hex 24)
WORKER_TOKEN=
