{
  "name": "layerto",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "node --experimental-strip-types --test 'packages/*/src/**/*.test.ts' 'apps/*/src/**/*.test.ts' && (cd services/core && go test -count=1 -p 1 ./...)",
    "ui:shots": "node --experimental-strip-types scripts/ui-shots.ts",
    "ui:a11y": "node --experimental-strip-types scripts/ui-a11y.ts",
    "docs:check": "bash scripts/docs-check.sh",
    "lint": "turbo run lint",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:roles": "./scripts/setup-roles.sh",
    "db:migrate": "go run github.com/pressly/goose/v3/cmd/goose@v3.28.0 -dir services/core/db/migrations postgres \"${MIGRATOR_DATABASE_URL:-postgres://layerto:layerto@localhost:5434/layerto?sslmode=disable}\" up",
    "sqlc": "go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.28.0 generate -f services/core/sqlc.yaml",
    "test:ts": "node --experimental-strip-types --test 'packages/*/src/**/*.test.ts' 'apps/*/src/**/*.test.ts'"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.64.1",
    "turbo": "^2.4.4"
  }
}
